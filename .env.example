# Copy to .env and fill in. docker-compose reads this file.

# --- LLM provider ----------------------------------------------------------
# One of: openai | anthropic | ollama
CP_LLM_PROVIDER=openai

# OpenAI
OPENAI_API_KEY=
CP_OPENAI_MODEL=gpt-4o-mini

# Anthropic (Claude)
ANTHROPIC_API_KEY=
CP_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Ollama (local, no API key)
CP_OLLAMA_BASE_URL=http://host.docker.internal:11434
CP_OLLAMA_MODEL=llama3.1:8b

# --- FHIR endpoint ---------------------------------------------------------
# Defaults to the IRIS-hosted FHIR R4 endpoint created at boot.
CP_FHIR_BASE_URL=http://iris:52773/csp/healthshare/centralpark/fhir/r4
CP_FHIR_AUTH=basic
CP_FHIR_USER=_SYSTEM
CP_FHIR_PASSWORD=SYS

# --- IRIS admin (Community Edition default) --------------------------------
IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS
