# Copy to .env and fill in your OpenAI key.
#
# Central Park needs one external thing: an OPENAI_API_KEY. It's used in two
# places, both of which read from this single variable:
#   1. IRIS's %Embedding.OpenAI (AI Hub) embeds guidelines and queries
#   2. The Python sidecar calls Chat Completions for the triage reason step
# Both calls go directly to OpenAI; no other external services are required.

# --- Required ---------------------------------------------------------------
OPENAI_API_KEY=

# --- Optional: which model the sidecar uses for chat ------------------------
CP_LLM_PROVIDER=openai
CP_OPENAI_MODEL=gpt-4o-mini

# --- Optional: Anthropic instead of OpenAI for chat -------------------------
# Embeddings still use OpenAI (no Anthropic embedding API exists).
# Set CP_LLM_PROVIDER=anthropic to switch.
ANTHROPIC_API_KEY=
CP_ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# --- Optional: Ollama for offline chat (experimental) -----------------------
# Set CP_LLM_PROVIDER=ollama and enable the bundled Ollama service with:
#   docker compose --profile ollama up
# Known issue: llama.cpp can crash mid-inference on Apple Silicon Docker
# Desktop. Linux x86 hosts are reliable.
CP_OLLAMA_BASE_URL=http://ollama:11434
CP_OLLAMA_MODEL=llama3.2:3b

# --- IRIS endpoints (defaults match docker-compose service names) -----------
CP_FHIR_BASE_URL=http://iris:52773/csp/healthshare/centralpark/fhir/r4
CP_FHIR_USER=_SYSTEM
CP_FHIR_PASSWORD=SYS
CP_IRIS_REST_BASE_URL=http://iris:52773/centralpark

IRIS_USERNAME=_SYSTEM
IRIS_PASSWORD=SYS
