        "item": [
          {"linkId": "chief-complaint", "text": "What's bothering you today?", "answer": [{"valueString": "I suddenly can't catch my breath and I'm wheezing badly."}]},
          {"linkId": "onset", "text": "When did it start, and how has it changed?", "answer": [{"valueString": "About an hour ago and it's getting worse fast."}]},
          {"linkId": "severity", "text": "How bad is it right now?", "answer": [{"valueString": "9 out of 10"}]},
          {"linkId": "associated-symptoms", "text": "Are you noticing any of these as well?", "answer": [{"valueString": "Shortness of breath, Chest tightness"}]},
