        "item": [
          {"linkId": "chief-complaint", "text": "What's bothering you today?", "answer": [{"valueString": "Sore throat and a blocked nose."}]},
          {"linkId": "onset", "text": "When did it start, and how has it changed?", "answer": [{"valueString": "Two days ago, about the same since."}]},
          {"linkId": "severity", "text": "How bad is it right now?", "answer": [{"valueString": "3 out of 10"}]},
          {"linkId": "associated-symptoms", "text": "Are you noticing any of these as well?", "answer": [{"valueString": "None of these"}]},
          {"linkId": "history", "text": "Has this happened before, or any recent illness or injury?", "answer": [{"valueString": "Just the usual winter colds."}]},
          {"linkId": "self-treatment", "text": "Have you tried anything for it yet?", "answer": [{"valueString": "Warm fluids and a paracetamol last night."}]}
        ]
