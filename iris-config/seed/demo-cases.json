        "authored": "2026-06-07T07:40:00Z",
        "item": [
          {"linkId": "chief-complaint", "text": "What's bothering you today?", "answer": [{"valueString": "A cough that won't go away and brings up green phlegm."}]},
          {"linkId": "onset", "text": "When did it start, and how has it changed?", "answer": [{"valueString": "About three weeks ago, slowly getting worse."}]},
          {"linkId": "severity", "text": "How bad is it right now?", "answer": [{"valueString": "5 out of 10"}]},
          {"linkId": "associated-symptoms", "text": "Are you noticing any of these as well?", "answer": [{"valueString": "Shortness of breath"}]},
          {"linkId": "history", "text": "Has this happened before, or any recent illness or injury?", "answer": [{"valueString": "I have COPD and get chest infections now and then."}]},
          {"linkId": "self-treatment", "text": "Have you tried anything for it yet?", "answer": [{"valueString": "Using my blue inhaler more than usual."}]}
        ]
      }
